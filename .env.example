# Copy this file to .env for local `vercel dev` testing only.
# In production, set these as Environment Variables in the Vercel project
# settings instead — never commit an actual .env file.

# Your personal GroupMe access token.
# Get it at https://dev.groupme.com -> sign in -> "Access Token" in the nav.
# Treat this exactly like a password: never commit it, never paste it into
# chat, never share it. Anyone with it can act on your GroupMe account.
GROUPME_TOKEN=

# The numeric group/conversation id — the number at the end of your group's
# web.groupme.com/chats/group/<this-number> URL.
GROUPME_GROUP_ID=116890521

# A secret string you make up yourself (e.g. run `openssl rand -hex 16`).
# It becomes the last segment of your subscribe URL, so treat it as a
# password too — anyone who has it can see your group's schedule.
CALENDAR_SECRET=

# Optional: display name for the calendar in apps that show one.
CALENDAR_NAME=Sonics Fall'26
